{
  "manifest_version": 3,
  "name": "LinkedIn Network Helper",
  "version": "1.3.6",
  "description": "Withdraw sent invitations, send catch-up messages, and export or remove connections — with human-like timing.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Network Helper"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/mynetwork/invitation-manager/sent*"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/mynetwork/catch-up*"],
      "js": ["catchup.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/mynetwork/invite-connect/connections*"],
      "js": ["connections.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ]
}
